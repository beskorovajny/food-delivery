    {
      "name": "Order Service (port 8084)",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 1,\n  \"restaurantId\": 1,\n  \"deliveryAddress\": {\n    \"street\": \"Doroshenka\",\n    \"house\": \"12\",\n    \"apartment\": \"5A\",\n    \"city\": \"Lviv\",\n    \"comment\": \"Leave at the door\"\n  },\n  \"items\": [\n    {\n      \"menuItemId\": 10,\n      \"quantity\": 2\n    },\n    {\n      \"menuItemId\": 15,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrlOrder}}/api/orders",
              "host": ["{{baseUrlOrder}}"],
              "path": ["api", "orders"]
            },
            "description": "POST /api/orders\nCreates a new order (requires CUSTOMER role)"
          },
          "response": []
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrlOrder}}/api/orders/1",
              "host": ["{{baseUrlOrder}}"],
              "path": ["api", "orders", "1"]
            },
            "description": "GET /api/orders/{orderId}\nReturns order details (customer owns it or restaurant/admin)"
          },
          "response": []
        },
